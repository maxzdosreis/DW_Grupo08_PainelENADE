# Copie para .env.development se precisar mudar o destino do proxy do "npm run dev".
# O Vite encaminha /api/* para este endereco (ja incluindo o /api do PHP).

# Padrao: servidor embutido do PHP, iniciado na raiz do repositorio com
#   php -S localhost:8080 -t app
VITE_PROXY_TARGET=http://localhost:8080/api

# Alternativa com Apache/XAMPP (troque NOME_DA_PASTA pela pasta em htdocs):
# VITE_PROXY_TARGET=http://localhost/NOME_DA_PASTA/app/api
